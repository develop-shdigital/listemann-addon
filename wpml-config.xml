<wpml-config>
	<!--
		Listemann Toolkit Addon: translatable texts of the global features
		(option "listemann_toolkit_settings"). Read by WPML String Translation
		("Admin texts") and by Polylang. Save the settings page once so the
		option exists before translating.
	-->
	<admin-texts>
		<key name="listemann_toolkit_settings">
			<key name="contact">
				<key name="label" />
				<key name="sections">
					<key name="*">
						<key name="title" />
						<key name="lines">
							<key name="*">
								<key name="text" />
								<key name="url" />
							</key>
						</key>
					</key>
				</key>
			</key>
			<key name="to_top">
				<key name="label" />
			</key>
		</key>
	</admin-texts>
	<!--
		Texts of the Elementor widgets, shown in WPML's Translation Editor when
		a page that uses the widgets is translated. Menus and templates are
		selected per language in Elementor and are not listed here.
	-->
	<elementor-widgets>
		<widget name="listemann-continuous-slider">
			<fields>
				<field type="Continuous Slider: Accessible label" editor_type="LINE">aria_label</field>
			</fields>
			<fields-in-item items_of="slides">
				<field type="Continuous Slider: Slide title" editor_type="LINE">title</field>
				<field type="Continuous Slider: Slide link" editor_type="LINK">link>url</field>
			</fields-in-item>
		</widget>
		<widget name="listemann-menu">
			<fields>
				<field type="Listemann Menu: Accessible label" editor_type="LINE">aria_label</field>
			</fields>
		</widget>
		<widget name="listemann-header">
			<fields>
				<field type="Listemann Header: Logo link" editor_type="LINK">logo_link>url</field>
				<field type="Listemann Header: Logo alternative text" editor_type="LINE">logo_alt</field>
				<field type="Listemann Header: Main menu accessible label" editor_type="LINE">menu_aria_label</field>
				<field type="Listemann Header: Off-canvas accessible label" editor_type="LINE">offcanvas_label</field>
			</fields>
			<fields-in-item items_of="offcanvas_columns">
				<field type="Listemann Header: Menu column accessible label" editor_type="LINE">label</field>
			</fields-in-item>
			<fields-in-item items_of="social_links">
				<field type="Listemann Header: Social link" editor_type="LINK">link>url</field>
				<field type="Listemann Header: Social link accessible label" editor_type="LINE">label</field>
			</fields-in-item>
		</widget>
		<widget name="listemann-downloads">
			<fields>
				<field type="Listemann Downloads: Heading" editor_type="LINE">heading_text</field>
				<field type="Listemann Downloads: Label template" editor_type="LINE">label_template</field>
			</fields>
			<fields-in-item items_of="items">
				<field type="Listemann Downloads: Group title" editor_type="LINE">group_title</field>
				<field type="Listemann Downloads: Download title" editor_type="LINE">title</field>
				<field type="Listemann Downloads: Download URL" editor_type="LINK">link>url</field>
				<field type="Listemann Downloads: Download label" editor_type="LINE">label</field>
			</fields-in-item>
		</widget>
		<widget name="listemann-posts">
			<fields>
				<field type="Listemann Posts: Heading" editor_type="LINE">heading_text</field>
				<field type="Listemann Posts: Custom date format" editor_type="LINE">date_format_custom</field>
				<field type="Listemann Posts: Filter label" editor_type="LINE">filter_label</field>
				<field type="Listemann Posts: Filter &quot;All&quot; option" editor_type="LINE">filter_all_text</field>
				<field type="Listemann Posts: Load more button text" editor_type="LINE">load_more_text</field>
				<field type="Listemann Posts: Loading text" editor_type="LINE">loading_text</field>
				<field type="Listemann Posts: All posts shown text" editor_type="LINE">no_more_text</field>
				<field type="Listemann Posts: No posts text" editor_type="LINE">empty_text</field>
			</fields>
		</widget>
		<widget name="listemann-footer">
			<fields>
				<field type="Listemann Footer: Logo link" editor_type="LINK">logo_link>url</field>
				<field type="Listemann Footer: Logo alternative text" editor_type="LINE">logo_alt</field>
				<field type="Listemann Footer: Bottom bar text" editor_type="LINE">bottom_text</field>
				<field type="Listemann Footer: Legal links accessible label" editor_type="LINE">bottom_menu_label</field>
			</fields>
			<fields-in-item items_of="social_links">
				<field type="Listemann Footer: Social link" editor_type="LINK">link>url</field>
				<field type="Listemann Footer: Social link accessible label" editor_type="LINE">label</field>
			</fields-in-item>
			<fields-in-item items_of="menu_columns">
				<field type="Listemann Footer: Menu column accessible label" editor_type="LINE">label</field>
			</fields-in-item>
		</widget>
	</elementor-widgets>
</wpml-config>
