msgstr "Buttons anzeigen"

#: includes/widgets/class-continuous-slider.php:554
msgid "Always"
msgstr "Immer"

#: includes/widgets/class-continuous-slider.php:555
msgid "On hover and keyboard focus"
msgstr "Bei Hover und Tastaturfokus"

#: includes/widgets/class-continuous-slider.php:558
